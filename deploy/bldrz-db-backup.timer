# Do not enable before off-server transfer, retention and failure alerts exist.
[Unit]
Description=Daily bldrz PostgreSQL backup (off-server integration required)

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
RandomizedDelaySec=300
Persistent=true
Unit=bldrz-db-backup.service

[Install]
WantedBy=timers.target
