[Unit]
Description=WellSim v2 comparison app for bldrz.net
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=bldrz
Group=bldrz
WorkingDirectory=/opt/bldrz/app
Environment=NODE_ENV=production
Environment=PORT=3356
Environment=WELLSIM_ENABLE_LEGACY_CASE_STORE=0
EnvironmentFile=/etc/bldrz/postgresql.env
Environment=WELLSIM_DATABASE_ENABLED=1
Environment=WELLSIM_AUTH_ENABLED=0
Environment=WELLSIM_ONBOARDING_ENABLED=0
Environment=WELLSIM_DB_LOGIN_ROLE=bldrz_app
Environment=WELLSIM_DB_RUNTIME_ROLE=bldrz_runtime
Environment=WELLSIM_DB_POOL_MAX=10
Environment=WELLSIM_DB_MAX_PENDING=50
Environment=WELLSIM_DB_STATEMENT_TIMEOUT_MS=15000
ExecStart=/usr/bin/node /opt/bldrz/app/src/server/server.js
Restart=always
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/bldrz/app/data /opt/bldrz/app/data-backups
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
