[Unit]
Description=Encrypted WellSim case-store backup (off-box destined)
After=wellsim.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/wellsim/app/deploy/backup-wellsim-data.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/wellsim /run/lock
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=true
